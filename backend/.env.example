# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+mysqldb://root:yourpassword@localhost:3306/nousqa_platform

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-value

# ── Domain restriction ────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=nousinfo.com

# ── SSO ───────────────────────────────────────────────────────────────────────
# Set to "true" to enable the Microsoft Azure AD SSO login button.
SSO_ENABLED=true

# Azure AD (Entra ID) – register your app at:
#   https://portal.azure.com → Azure Active Directory → App registrations
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-value

# Redirect URI — must match what is registered in your Azure AD app exactly.
# Production example: https://api.yourdomain.com/api/auth/sso/callback
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback

# After SSO the backend redirects the browser to this frontend base URL.
# Production example: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173
